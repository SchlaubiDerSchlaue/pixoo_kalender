# iCal-Link von Outlook (Kalenderfreigabe > ICS-Link kopieren)
ICAL_URL=https://outlook.live.com/owa/calendar/DEIN-LINK/calendar.ics

# IP-Adresse des Pixoo64 im lokalen Netzwerk
PIXOO_IP=192.168.178.188

# Anzahl Termine (Standard: 5)
MAX_EVENTS=5

# Zeitzone (Standard: Europe/Berlin)
TIMEZONE=Europe/Berlin

# Display-Helligkeit 0-100 (Standard: 80)
BRIGHTNESS=80
